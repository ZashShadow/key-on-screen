**/target/
src-tauri/gen/schemas/
src-tauri/gen/android/
src-tauri/gen/ios/

# Environment, secrets & signing keys (CRITICAL SECURITY)
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.pub
*.pfx
*.p12
*.cer
*.crt
*.keystore
*.jks
*.sig

# Compiled binaries & installers (outside target/)
*.exe
*.msi
*.dll
*.dylib
*.so

